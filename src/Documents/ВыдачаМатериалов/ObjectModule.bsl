
Процедура ОбработкаПроведения(Отказ, РежимПроведения)

    // 1. Проверка заголовка документа
    Если НЕ ЗначениеЗаполнено(Склад) Тогда
        Отказ = Истина;
        Возврат;
    КонецЕсли;

    Если Материалы.Количество() = 0 Тогда
        Отказ = Истина;
        Возврат;
    КонецЕсли;

    СписокМатериалов = Новый Массив;

    // 2. Проверка строк
    Для Каждого СтрокаДокумента Из Материалы Цикл

        Если НЕ ЗначениеЗаполнено(СтрокаДокумента.Материал)
            Или СтрокаДокумента.Количество <= 0 Тогда

            Отказ = Истина;
            Возврат;

        КонецЕсли;

        Если СписокМатериалов.Найти(
            СтрокаДокумента.Материал) = Неопределено Тогда

            СписокМатериалов.Добавить(
                СтрокаДокумента.Материал);

        КонецЕсли;

    КонецЦикла;

    // 3. Подготовка движений
    Движения.ОстаткиМатериалов.Записывать = Истина;

    Движения.ОстаткиМатериалов.БлокироватьДляИзменения =
        Истина;

    Для Каждого СтрокаДокумента Из Материалы Цикл

        Движение =
            Движения.ОстаткиМатериалов.Добавить();

        Движение.ВидДвижения =
            ВидДвиженияНакопления.Расход;

        Движение.Период = Дата;

        Движение.Склад = Склад;

        Движение.Материал =
            СтрокаДокумента.Материал;

        Движение.Количество =
            СтрокаДокумента.Количество;

    КонецЦикла;

    // 4. Запись движений внутри транзакции проведения
    Движения.ОстаткиМатериалов.Записать();

    // 5. Проверка отрицательных остатков
    Запрос = Новый Запрос;

    Запрос.Текст =
        "ВЫБРАТЬ
        |   Остатки.Материал КАК Материал,
        |   Остатки.КоличествоОстаток КАК Остаток
        |ИЗ
        |   РегистрНакопления.ОстаткиМатериалов.Остатки(
        |       ,
        |       Склад = &Склад
        |       И Материал В (&СписокМатериалов)
        |   ) КАК Остатки
        |ГДЕ
        |   Остатки.КоличествоОстаток < 0";

    Запрос.УстановитьПараметр("Склад", Склад);

    Запрос.УстановитьПараметр(
        "СписокМатериалов", СписокМатериалов);

    Выборка = Запрос.Выполнить().Выбрать();

    Пока Выборка.Следующий() Цикл

        Сообщение = Новый СообщениеПользователю;

        Сообщение.Текст =
            "Недостаточно материала: "
            + Строка(Выборка.Материал)
            + ". Дефицит: "
            + Строка(-Выборка.Остаток);

        Сообщение.Сообщить();

        Отказ = Истина;

    КонецЦикла;

КонецПроцедуры
