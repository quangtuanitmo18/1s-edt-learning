 
Процедура ОбработкаПроведения(Отказ, РежимПроведения)

    // 1. Проверяем склад
    Если НЕ ЗначениеЗаполнено(Склад) Тогда

        Сообщить("Не указан склад");
        Отказ = Истина;
        Возврат;

    КонецЕсли;

    // 2. Проверяем табличную часть
    Если Материалы.Количество() = 0 Тогда

        Сообщить("Список материалов пуст");
        Отказ = Истина;
        Возврат;

    КонецЕсли;

    // 3. Проверяем строки
    Для Каждого СтрокаМатериала Из Материалы Цикл

        Если НЕ ЗначениеЗаполнено(СтрокаМатериала.Материал)
            Или СтрокаМатериала.Количество <= 0 Тогда

            Сообщить("Некорректная строка материала");
            Отказ = Истина;
            Возврат;

        КонецЕсли;

    КонецЦикла;

    // 4. Формируем движения
    Движения.ОстаткиМатериалов.Записывать = Истина;

    Для Каждого СтрокаМатериала Из Материалы Цикл

        Движение =
            Движения.ОстаткиМатериалов.Добавить();

        Движение.ВидДвижения =
            ВидДвиженияНакопления.Приход;

        Движение.Период = Дата;

        Движение.Материал =
            СтрокаМатериала.Материал;

        Движение.Склад = Склад;

        Движение.Количество =
            СтрокаМатериала.Количество;

    КонецЦикла;

КонецПроцедуры
