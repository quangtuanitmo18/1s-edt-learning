

&НаКлиенте
Процедура ПроверитьОстаток(Команда)

    // Проверяем, что материал уже записан.
    Если НЕ ЗначениеЗаполнено(Объект.Ссылка) Тогда

        Сообщить(
            "Сначала запишите материал");

        Возврат;

    КонецЕсли;

    // Проверяем выбранный склад.
    Если НЕ ЗначениеЗаполнено(СкладПроверки) Тогда

        Сообщить(
            "Выберите склад");

        Возврат;

    КонецЕсли;

    // Вызов серверной функции без контекста.
    ОстатокПоСкладу =
        ПолучитьОстатокНаСервере(
            Объект.Ссылка,
            СкладПроверки);

    Сообщить(
        "Остаток: "
        + Строка(ОстатокПоСкладу));

КонецПроцедуры

&НаСервереБезКонтекста
Функция ПолучитьОстатокНаСервере(
    Знач Материал,
    Знач Склад)

    Запрос = Новый Запрос;

    Запрос.Текст =
        "ВЫБРАТЬ
        |   Остатки.КоличествоОстаток КАК Количество
        |ИЗ
        |   РегистрНакопления.ОстаткиМатериалов.Остатки(
        |       ,
        |       Материал = &Материал
        |       И Склад = &Склад
        |   ) КАК Остатки";

    Запрос.УстановитьПараметр(
        "Материал", Материал);

    Запрос.УстановитьПараметр(
        "Склад", Склад);

    РезультатЗапроса = Запрос.Выполнить();

    Выборка = РезультатЗапроса.Выбрать();

    Если Выборка.Следующий() Тогда

        Возврат Выборка.Количество;

    КонецЕсли;

    Возврат 0;

КонецФункции
